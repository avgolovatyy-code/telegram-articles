# ---------------------------------------------------------------------------
# WeGoTrip Telegram Content Engine — example environment
# Copy to .env and fill in the secrets. NEVER commit a real .env.
# ---------------------------------------------------------------------------

APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=console
TIMEZONE=UTC
ADMIN_BASE_URL=http://localhost:8000

# --------------------------------------------------------------- database ---
# Production: postgresql+psycopg://user:password@host:5432/wegotrip_engine
# Local without a server: sqlite+pysqlite:///./var/engine.sqlite3
DATABASE_URL=postgresql+psycopg://wegotrip:wegotrip@localhost:5432/wegotrip_engine
DATABASE_ECHO=false

# --------------------------------------------------------- WeGoTrip API -----
WEGOTRIP_API_BASE_URL=https://app.wegotrip.com/api
# Affiliate identifier — NOT a secret. Every store link must carry coupon=<this>.
WEGOTRIP_REFERER_ID=435
# Optional: only needed if the affiliate programme issues you a key.
WEGOTRIP_API_KEY=
WEGOTRIP_STORE_DOMAIN_EN=wegotrip.com
WEGOTRIP_STORE_DOMAIN_RU=wegotrip.ru
WEGOTRIP_CURRENCY_EN=EUR
WEGOTRIP_CURRENCY_RU=RUB
WEGOTRIP_RATE_LIMIT_RPS=4
# http = live Affiliate API, mock = bundled fixtures for offline development
CATALOG_PROVIDER=http

# ----------------------------------------------------------------- Telegram --
TELEGRAM_BOT_TOKEN=
TELEGRAM_EN_CHANNEL=@wegotrip
TELEGRAM_RU_CHANNEL=@wegotrip_ru
# Always publish to the test channel before touching production.
TELEGRAM_TEST_CHANNEL=
# true = build and validate the payload but never call the Bot API
TELEGRAM_DRY_RUN=false

# --------------------------------------------------------------------- Max --
# Secondary RU publish surface. Telegram stays primary; Max failures never block it.
# Chat id: numeric API id (preferred), e.g. -71234567890123, or public slug/URL
# like NNNNNNNN_biz / https://max.ru/idNNNNNNNN_biz (resolved via the public page).
MAX_BOT_TOKEN=
MAX_RU_CHANNEL_ID=
MAX_PUBLISH_RU=true
# MAX_API_BASE_URL=https://platform-api2.max.ru
# MAX_SSL_VERIFY=true
# MAX_SSL_CA_FILE=

# ------------------------------------------------------------------- OpenAI --
OPENAI_API_KEY=
OPENAI_WRITER_MODEL=gpt-5.6-terra
OPENAI_UTILITY_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-5.6-sol
# Empty = reuse the utility model for the critic pass
OPENAI_REVIEW_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-2
# openai = live API, mock = deterministic offline generator
LLM_PROVIDER=openai

# ------------------------------------------------------------------- budget --
# The hard cap. Nothing else limits how much is generated.
DAILY_AI_BUDGET_USD=3.00
# Priority floor per market: these are funded first, alternating between markets.
EN_ARTICLES_MIN_PER_DAY=10
RU_ARTICLES_MIN_PER_DAY=10
# Daily ceiling per market. 0 = no ceiling, so a cheap day can produce more than 20
# per market as long as the spend stays inside DAILY_AI_BUDGET_USD.
EN_ARTICLES_MAX_PER_DAY=0
RU_ARTICLES_MAX_PER_DAY=0
BUDGET_SAFETY_MARGIN_USD=0.05
# Topics below this score are left unwritten rather than padding out a daily quota.
MIN_TOPIC_SCORE=0.25

# --------------------------------------------------------------- publishing --
# Полностью автоматическая публикация: статья выходит сама, если прошла все проверки.
# Тестовая публикация в TELEGRAM_TEST_CHANNEL всё равно делается первой.
# Поставьте false, если хотите утверждать каждую статью руками.
AUTO_PUBLISH_EN=true
AUTO_PUBLISH_RU=true
# Publications per market per day. 0 = publish everything that is ready, spread over
# the window; the AI budget already bounds how much gets written in the first place.
EN_PUBLISH_PER_DAY=0
RU_PUBLISH_PER_DAY=0
# Posts are spread across the whole window; this is only the floor for the gap.
MIN_POST_INTERVAL_MINUTES=20
# Window hours are local to PUBLISH_TIMEZONE. Default: 10:00–21:00 Moscow time.
PUBLISH_TIMEZONE=Europe/Moscow
PUBLISH_WINDOW_START_HOUR=9
PUBLISH_WINDOW_END_HOUR=21

# ------------------------------------------------------------------ quality --
MIN_QUALITY_SCORE=0.88
MIN_FACTUALITY_SCORE=0.97
DEDUP_SIMILARITY_THRESHOLD=0.82

# -------------------------------------------------------------------- media --
# Generated covers are a controlled exception, disabled by default.
ALLOW_GENERATED_COVERS=false
VALIDATE_MEDIA_OVER_NETWORK=true

# ----------------------------------------------------------------- hashtags --
ENABLE_HASHTAGS=true
MAX_HASHTAGS=4

# ---------------------------------------------------------------- analytics --
# Public base URL used for /r/<token> click tracking. Defaults to ADMIN_BASE_URL.
TRACKING_BASE_URL=
# Route product buttons through /r/<token> so clicks can be counted. The redirect
# target always keeps coupon=<referer id> and the UTM parameters either way.
USE_TRACKING_REDIRECT=true

# --------------------------------------------------------------------- Slack --
# Необязательно. Движок работает и без Slack — тогда всё видно в админке.
# Slack нужен как окно наблюдения: уведомления о публикациях, сводка за день,
# алерты об ошибках и кнопки «снять с публикации» / «перегенерировать».
# Если заданы токен, signing secret и канал, интеграция включается сама —
# SLACK_ENABLED=true отдельно ставить не нужно.
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Идентификатор канала (C0BTME6R546) или его имя (#telegram-articles)
SLACK_CHANNEL=#telegram-articles
SLACK_NOTIFY_ON_DRAFT=true
SLACK_NOTIFY_ON_PUBLISH=true
SLACK_DIGEST_HOUR=18

# --------------------------------------------------------------------- admin --
ADMIN_USERNAME=admin
# Leave empty to disable HTTP basic auth (local development only).
ADMIN_PASSWORD=
SCHEDULER_ENABLED=true
