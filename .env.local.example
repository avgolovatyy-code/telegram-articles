# Fully offline development profile: no API keys, no network, no spend.
# Copy to .env to run the whole pipeline against bundled fixtures.

APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=console
DATABASE_URL=sqlite+pysqlite:///./var/engine.sqlite3

CATALOG_PROVIDER=mock
LLM_PROVIDER=mock
TELEGRAM_DRY_RUN=true
TELEGRAM_TEST_CHANNEL=@wegotrip_content_test
VALIDATE_MEDIA_OVER_NETWORK=false
SCHEDULER_ENABLED=false

WEGOTRIP_REFERER_ID=435
DAILY_AI_BUDGET_USD=3.00
AUTO_PUBLISH_EN=false
AUTO_PUBLISH_RU=false
ALLOW_GENERATED_COVERS=false
